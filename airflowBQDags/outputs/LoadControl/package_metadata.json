    "Package\\Reserve ProcessID": {
      "task_metadata": {
        "query": "    DECLARE @ProcessID Bigint = ?, @DisableLnkLoad bit  = ?;\n --\n -- Reserve ProcessId for this job\n --\n    DECLARE \n        @Component VARCHAR(250) = 'Load TrackAndTrace - Job Start',\n        @Started DATETIME2(3) = SYSDATETIME(),\n        @Ended DATETIME2(3),\n        @Result VARCHAR(20),\n        @ErrorMessage VARCHAR(250) = '',\n        @Inserted INT = 0;\n \n  IF (@DisableLnkLoad = 1) SET @Component  = 'Load Labels - Job Start';\n\n    EXEC [Staging].[SaveLog] \n        @Component,\n        @ProcessID,\n        @Started,\n        @Ended,\n        @Result,\n        @ErrorMessage,\n        @Inserted; ",
        "param_map": {
          "param_0": {
            "variable_name": "ProcessId",
            "direction": "Input"
          },
          "param_1": {
            "variable_name": "DisableLNKLoad",
            "direction": "Input"
