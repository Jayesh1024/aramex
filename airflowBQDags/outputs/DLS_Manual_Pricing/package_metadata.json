              "Package\\Source2 (DynamicLabel) _DL\\Load API_RF_AdHocLabel_AllocationHistory_Stg_Weekly\\Load API_RF_AdHocLabel_AllocationHistory data (OnlineEnquiries_NEW)": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @LastID INT = ?;\n--Get Previous Sunday or Today if day is SUN  - 19050101 was a SUN\nDECLARE @maxDate  date = DATEADD(wk, DATEDIFF(wk, '19050101',  GETDATE()), '19050101')\n\n\nSET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;\n\nSELECT\n       [HistoryID]\n      ,[SystemID]\n      ,[LabelColour]\n      ,[LabelNumber]\n      ,[CountryCode]\n      ,[Franchise]\n      ,[PriceSoldAtExGST]\n      ,[DateAllocatedUTC]\n      ,[ExternalReference]\n      ,[CustomerID]\n      ,[FKID]\n      ,[FKSource]\n      ,[FMSInvoiceID]\n      ,[FMSProductID]\n      ,[AllocatedByCustomer]\n      ,[CustomerUniqueID]\n      ,[PickupTown]\n      ,[PickupPostcode]\n      ,[DeliveryTown]\n      ,[DeliveryPostcode]\n      ,[Weight]\n      ,[DateAllocatedRelativeToRF]\n      ,[DeletedLabel]\n      ,[DeliveryAddr1]\n      ,[DeliveryAddr2]\n      ,[PickupAddr1]\n      ,[PickupAddr2]\n      ,[GroupTransId]\n      ,[DeliveryPhoneNo]\n      ,[LengthInCm]\n      ,[WidthInCm]\n      ,[HeightInCm]\n      ,[CubicWeight]\nFROM [OnlineEnquiries_NEW].[dbo].[API_RF_AdHocLabel_AllocationHistory] WITH (NOLOCK)\n  WHERE [HistoryID] > @LastID - 6000000\n AND [DateAllocatedUTC] <  @maxDate",
                  "connection_names": [
                    "Project.ConnectionManagers[GOKU.OnlineEnquiries_NEW]"
                  ],
                  "inline_positional_params": true,
