            "query": "USE FastwayDW\nGO\n\n\nTRUNCATE TABLE [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg] \nGO\n\nINSERT INTO [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg] \n(\n\t  [HistoryID]\n      ,[SystemID]\n      ,[LabelColour]\n      ,[LabelNumber]\n      ,[CountryCode]\n      ,[Franchise]\n      ,[PriceSoldAtExGST]\n      ,[DateAllocatedUTC]\n      ,[ExternalReference]\n      ,[CustomerID]\n      ,[FKID]\n      ,[FKSource]\n      ,[FMSInvoiceID]\n      ,[FMSProductID]\n      ,[AllocatedByCustomer]\n      ,[CustomerUniqueID]\n      ,[PickupTown]\n      ,[PickupPostcode]\n      ,[DeliveryTown]\n      ,[DeliveryPostcode]\n      ,[Weight]\n      ,[DateAllocatedRelativeToRF]\n      ,[DeletedLabel]\n      ,[DeliveryAddr1]\n      ,[DeliveryAddr2]\n      ,[PickupAddr1]\n      ,[PickupAddr2]\n      ,[GroupTransId]\n      ,[DeliveryPhoneNo]\n      ,[LengthInCm]\n      ,[WidthInCm]\n      ,[HeightInCm]\n      ,[CubicWeight]\n)\nSELECT [HistoryID]\n      ,[SystemID]\n      ,H.[LabelColour]\n      ,[LabelNumber]\n      ,H.[CountryCode]\n      ,[Franchise]\n      ,[PriceSoldAtExGST]\n      ,[DateAllocatedUTC]\n      ,[ExternalReference]\n      ,[CustomerID]\n      ,H.[FKID]\n      ,H.[FKSource]\n      ,H.[FMSInvoiceID]\n      ,H.[FMSProductID]\n      ,[AllocatedByCustomer]\n      ,[CustomerUniqueID]\n      ,[PickupTown]\n      ,[PickupPostcode]\n      ,[DeliveryTown]\n      ,[DeliveryPostcode]\n      ,[Weight]\n      ,[DateAllocatedRelativeToRF]\n      ,[DeletedLabel]\n      ,[DeliveryAddr1]\n      ,[DeliveryAddr2]\n      ,[PickupAddr1]\n      ,[PickupAddr2]\n      ,H.[GroupTransId]\n      ,[DeliveryPhoneNo]\n      ,[LengthInCm]\n      ,[WidthInCm]\n      ,[HeightInCm]\n      ,[CubicWeight]\nFROM  [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg_Weekly] H\nINNER JOIN  [FastwayDW].[dv].[SAT_Label_Allocation_DL] DL ON H.HistoryID = DL.[RecordSourceId] AND DL.IsCurrent = 1\nWHERE (\n\n\t(DL.Price != H.[PriceSoldAtExGST] )  OR \n\t( ISNULL(DL.FMSInvoiceID,0) != ISNULL(H.FMSInvoiceID,0) )  \n)\n\n\n",
