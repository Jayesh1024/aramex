        "Package\\Source2 (DynamicLabel) _DL\\Update Dim_Label": {
          "task_metadata": {
            "query": "DECLARE @ProcessID Int = ?;\nDECLARE @UpdateDate datetime2(7) = GetDate();\n\n\nUPDATE D\nSET D.[FMSInvoiceID] = A.[FMSInvoiceID],\n\t\tD.[Price] = A.[Price],\n\t\tProcessId = @ProcessID,\n\t\tUpdated = @UpdateDate\n\nFROM [FastwayDW].[dbo].[Dim_Label] D\nINNER JOIN [FastwayDW].[dv].[SAT_Label_Allocation_DL] A ON A.LabelNo = D.LabelNo AND IsCurrent = 1\nWHERE A.[ProcessId] = @ProcessID\n",
            "param_map": {
