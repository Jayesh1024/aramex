                  "Package\\Staging\\Staging 1\\Load fl_MF_Interim_Stg\\Load fl_MF_Interim_Stg": {
                    "component_type": "Microsoft.OLEDBSource",
                    "component_info": {
                      "sql_command": "DECLARE @ISOCountryCodes varchar(20) = ?\n\nDECLARE @AUCode int = IIF(CHARINDEX('AU', @ISOCountryCodes) > 0,1,0)\nDECLARE @NZCode int = IIF(CHARINDEX('NZ', @ISOCountryCodes) > 0,6,0)\n\ndeclare @startDate datetime = dateadd(day, -2,  GETDATE())\n\nDeclare @RealizedConsignments table (ConId Int NOT NULL);\n\nINSERT INTO @RealizedConsignments  (ConId)\nSELECT ConId \nFROM [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK)\nWHERE Con.[RealisedDate] >= @startDate\n\nSELECT  \nci.[Label],\ncon.CountryId,\nci.FromRf,\nci.FromCf,\nci.ToRf,\nci.ToCf,\ncon.ToLocality,\ncon.ToPostalCode,\ncon.RealisedDate,\nci.[Zone],\ncon.CreatedOn,\ncon.CustomerId,\ncon.UpdatedOn AS ConUpdatedOn,\nci.UpdatedOn AS ConItemUpdatedOn\n\nFROM @RealizedConsignments NC\nJOIN [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK)\tON con.Conid = nc.ConId\nJOIN [FWFastlabel].[dbo].[fl_ConItem] ci  with (NOLOCK) on ci.ConId = nc.ConId\nWHERE  Con.CountryId IN (@AUCode , @NZCode)",
                      "connection_names": [
                        "Project.ConnectionManagers[KRILLIN_Fastway]"
                      ],
                      "inline_positional_params": true,
                      "inline_positional_params_mapping": {
