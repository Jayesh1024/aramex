                  "Package\\Staging\\Staging 2\\Load TrackAndTrace_Stg\\TrackAndTrace data (Fastway)": {
                    "component_type": "Microsoft.OLEDBSource",
                    "component_info": {
                      "sql_command": "DECLARE @StartID bigint = ?;\nDECLARE @EndID bigint;\n\nDECLARE   @ISOCountryCodes varchar(20) = ?\n\nDECLARE @AUCode int = IIF(CHARINDEX('AU', @ISOCountryCodes) > 0,1,0)\nDECLARE @NZCode int = IIF(CHARINDEX('NZ', @ISOCountryCodes) > 0,6,0)\n\nSELECT @EndID = MAX(ID) - 1000 FROM FastwayReports.dbo.TrackAndTraceData a (nolock);\n\n\nSELECT\n    a.ID,\n    a.RecordId,\n    a.CountryCode,\n    a.FranchiseeCode,\n    a.ScanType,\n    a.[Status] AS ScanStatus,\n    a.LabelNo,\n    a.ScanDate,\n    a.CourierNo,\n    a.UploadDate,\n    a.RecordCreateDate,\n    a.iLocate\n    --FROM FastwayReports.dbo.TrackAndTrace_7Day a (nolock)\n    FROM FastwayReports.dbo.TrackAndTraceData a (nolock)\n    WHERE ID > @StartID  AND ID < @EndID\n      AND Countrycode  IN (@AUCode, @NZCode )",
                      "connection_names": [
                        "Project.ConnectionManagers[VEGETA_FastwayReports]"
                      ],
                      "inline_positional_params": true,
                      "inline_positional_params_mapping": {
