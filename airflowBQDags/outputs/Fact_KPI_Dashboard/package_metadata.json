            },
            "per_component_data": {
              "Package\\Staging 3\\Load fl_ConItemSrv_Stg\\fl_conItemSrv (Bulk Insert)": {
                "component_type": "Microsoft.OLEDBDestination",
                "component_info": {
                  "table_name": "fl_ConItemSrv_Stg_Interim",
                  "schema_name": "Staging",
                  "variables_used": {
