              "Package\\Staging 3\\Load fl_ConItemSrv_Stg\\fl_ConItemSrv (Fastway)": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @ISOCountryCodes varchar(20) = ?\n\nDECLARE @AUCode int = IIF(CHARINDEX('AU', @ISOCountryCodes) > 0,1,0)\nDECLARE @NZCode int = IIF(CHARINDEX('NZ', @ISOCountryCodes) > 0,6,0)\n\nDECLARE @startDate2 datetime2(4);\nDECLARE  @ConId bigint;\n\nSET @StartDate2 = CONVERT(varchar(10),DATEADD(DAY, IIF( CONVERT(TIME, GetDate() ) < '08:00',-2,-1), GetDate()),120)+'T23:59:59';\n\nSELECT TOP 1 @ConId = ConId\nFROM [FWFastlabel].dbo.fl_Con (NOLOCK)\nWHERE CreatedOn >= @StartDate2\nORDER BY CreatedOn\n\nSELECT ci.[Label]\n      ,cis.[ConId]\n      ,cis.[ConItemId]\n\n      ,ci.[LineNo]\n      ,ci.[CountryId]\n      ,CONVERT(Datetime2(3),con.[CreatedOn]) AS CreatedOn \n      ,cis.[ProductId]\n      ,cis.[ServiceItemId]\n      ,cis.[FMSInvoiceNo]\n      ,cis.[FMSInvoiceDate]\n      ,cis.[Price]\n      ,cis.[Tax]\n      \n,cis.[Total]\n      ,cis.[PickUpPrice]\n      ,cis.[DeliveryPrice]\n    ,cis.[DLBSBatchId]\n    ,cis.[DLBSInvoiceDate]\n    ,cis.[DLBSInvoiceNo]\n    ,cis.[DLBSPrice]\n    ,cis.[DLBSTax]\n    ,cis.[DLBSTotal]\n    ,cis.[PLBSBatchId]\n    ,cis.[PLBSInvoiceDate]\n    ,cis.[PLBSInvoiceNo]\n    ,cis.[PLBSPrice]\n    ,cis.[PLBSTax]\n    ,cis.[PLBSTotal]\n    ,cis.[BareProfileId]\n    ,cis.[ServicePrice]\n    ,cis.[ServicePriceComm]\n    ,cis.[ServicePriceCommPercent]\n    ,cis.[ServicePriceDiscountFixed]\n    ,cis.[ServicePriceDiscountPercent]\n    ,CONVERT(Datetime2(3),cis.[UpdatedOn]) AS UpdatedOn \n   FROM  [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK)\n  INNER JOIN [FWFastlabel].[dbo].[fl_ConItemSrv] cis with (NOLOCK)  on con.ConId = cis.ConId\n  \n  INNER JOIN [FWFastlabel].[dbo].[fl_ConItem] ci with (NOLOCK) on ci.ConId = cis.ConId AND ci.ConItemId = cis.[ConItemId]\nWHERE con.[ConId] >= @ConId\nAND ci.[CountryId] IN (@AUCode, @NZCode )",
                  "connection_names": [
                    "Project.ConnectionManagers[KRILLIN_Fastway]"
                  ],
                  "inline_positional_params": true,
                  "inline_positional_params_mapping": {
                    "param_1": "(unresolved:{47FBA5AB-D1E9-4066-B492-70DFBED0730C})"
