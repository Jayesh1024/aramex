            "per_component_data": {
              "Package\\Staging\\Load CustomerLinks_Stg\\CustomerLinks data (Fastway)": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "USE Fastway;\nSELECT \n    Concat(RFId, RIGHT('000'+CourierNumber,3), RIGHT('0000'+CAST(CustomerNumber AS VARCHAR(4)),4)) as CustomerKey, \n    ltrim(rtrim(fms.BusinessName)) as CustomerName,\n    fms.NMId as CountryCode, \n    fms.RFId as RFCode,\n    fms.CustomerId as FMSCustomerID, \n    lnk.OESCustomerID, \n    lnk.IFSCustomerCode,\n    lnk.IFSCustomerType  \nFROM FMS_Customer fms\nLEFT JOIN (\n    Select  \n        coalesce(oes.CountryCode,ifs.CountryCode) as CountryCode, \n        coalesce(oes.CustomerID, ifs.FMSCustomerId) as FMSCustomerID, \n        OESCustomerID, \n        IFSCustomerCode,\n        CustomerType as IFSCustomerType\n    From DLS_CustomerLinks oes\n    Full Join IFSCustomers ifs on oes.CustomerID = ifs.FMSCustomerId and oes.CountryCode = ifs.CountryCode and ifs.RFCode = oes.Franchise\n) lnk ON fms.CustomerId = lnk.FMSCustomerID and fms.NMId = lnk.CountryCode\nWHERE fms.NMId in (1,6,11,24)\nORDER BY 1;",
                  "connection_names": [
                    "Project.ConnectionManagers[KRILLIN_Fastway]"
                  ],
                  "variables_used": {
                    "open_rowset_variable": null,
                    "sql_command_variable": null,
