        "Package\\Final\\Update LoadControl LastScanDate (BLK_ManifestID)": {
          "task_metadata": {
            "query": "DECLARE @Source varchar(50) = ?;\nDECLARE @LastScanDate datetime;\n\nSELECT @LastScanDate = MAX([ScanDate]) From [Staging].[BLK_ContainerManifestContents_Stg] WHERE [ScanDate] < GETDATE()  -- prevent erroneous future dates\n\nUPDATE [Staging].[LoadControl] \nSET LastValue = CONVERT(varchar(30), @LastScanDate)\nWHERE [RecordSource] = @Source\n",
            "param_map": {
              "param_0": {
                "variable_name": "RecordSource2",
                "direction": "Input"
