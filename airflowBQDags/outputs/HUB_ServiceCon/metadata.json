            "Package\\Staging\\Load fl_ConSrv_Stg\\fl_ConSrv (Fastway)": {
              "component_type": "Microsoft.OLEDBSource",
              "component_info": {
                "sql_command": "DECLARE @startDate2 datetime  = DATEADD(DAY, -14, GETDATE());\nDECLARE  @ConId bigint\n\nSELECT TOP 1 @ConId = ConId\nFROM [FWFastlabel].dbo.fl_Con (NOLOCK)\nWHERE CreatedOn >= @StartDate2\nORDER BY CreatedOn\n\n\nSELECT cs.[ConId]\n,con.[CountryId]\n,con.[CreatedOn]\n,cs.[ProductId]\n,cs.[ServiceItemId]\n,cs.[FMSInvoiceNo]\n,cs.[FMSInvoiceDate]\n,cs.[Price]\n,cs.[Tax]\n,cs.[Total]\n,cs.[PickUpPrice]\n,cs.[DeliveryPrice]\n,cs.[DLBSBatchId]\n,cs.[DLBSInvoiceDate]\n,cs.[DLBSInvoiceNo]\n,cs.[DLBSPrice]\n,cs.[DLBSTax]\n,cs.[DLBSTotal]\n,cs.[PLBSBatchId]\n,cs.[PLBSInvoiceDate]\n,cs.[PLBSInvoiceNo]\n,cs.[PLBSPrice]\n,cs.[PLBSTax]\n,cs.[PLBSTotal]\n,cs.[ServicePrice]\n,cs.[ServicePriceDiscountPercent]\n,cs.[ServicePriceDiscountFixed]\n,cs.[ServicePriceCommPercent]\n,cs.[ServicePriceComm]\n,cs.[UpdatedOn]\nFROM [FWFastlabel].[dbo].[fl_ConSrv] cs WITH (NOLOCK)\nINNER JOIN [FWFastlabel].[dbo].[fl_Con] con WITH (NOLOCK) on con.ConId = cs.ConId\nWHERE con.ConId >= @ConId"
              }
