              "Package\\Source4 (MyFastway) _MF\\Load fl_ConItem_Stg\\fl_ConItem (Fastway)": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @startDate datetime = '1900-01-01 00:00:00';\nDECLARE @BatchDays int = -120;\nDECLARE @endDate datetime = @startDate;\nDECLARE  @ConId bigint;\nDECLARE  @EndConId bigint;\n\nIF (@StartDate = '1900-01-01 00:00:00' )\n\tBEGIN\n\t\tSET @startDate = DATEADD(DAY, @BatchDays, Getdate()); \n\t\tSET @endDate = Getdate(); \n\tEND\t\nELSE \n\tSET @startDate = DATEADD(DAY, @BatchDays, Getdate()); \n\nSELECT TOP 1 @ConId = ConId\nFROM [FWFastlabel].dbo.fl_Con (NOLOCK)\nWHERE CreatedOn >= @startDate\nORDER BY CreatedOn\n\nSELECT TOP 1 @EndConId = ConId\nFROM [FWFastlabel].dbo.fl_Con (NOLOCK)\nWHERE CreatedOn <= @endDate  \nORDER BY CreatedOn desc\n\n\nSELECT\nci.[Label],\ncon.ConId,\nci.ConItemId,\nci.[LineNo],\ncon.CountryId,\ncon.CreatedOn,\ncon.CustomerId,\nci.FromRf,\nci.FromCf,\nci.ToRf,\nci.ToCf,\nci.FMSInvoiceNo,\nci.FMSInvoiceDate,\ncis.Reference,\ncis.Quantity,\ncis.ProductId,\ncis.WeightDead,\ncis.WeightCubic,\ncis.WeightPriced,\ncis.Width,\ncis.Length,\ncis.Height,\ncon.FromBusinessName,\ncon.FromContactName,\ncon.FromStreetAddress,\ncon.FromLocality,\ncon.FromStateOrProvince,\ncon.FromPostalCode,\ncon.FromCountry,\ncon.FromPhoneNumber,\ncon.FromEmail,\ncon.FromLat,\ncon.FromLng,\ncon.ToBusinessName,\ncon.ToContactName,\ncon.ToStreetAddress,\ncon.ToLocality,\ncon.ToStateOrProvince,\ncon.ToPostalCode,\ncon.ToCountry,\ncon.ToPhoneNumber,\ncon.ToEmail,\ncon.ToLat,\ncon.ToLng,\ncon.RealisedDate,\nci.RealisedDate as ItemRealisedDate,\nci.BasePrice,\nci.ExcessPrice,\nci.PickUpPriceTotal,\nci.DeliveryPriceTotal,\nci.BasePriceComm,\nci.ExcessPriceComm,\nci.BasePriceDiscounted,\nci.ExcessPriceDiscounted,\nci.ItemPrice,\nci.ServicePrice,\nci.PLBSBatchId,\nci.PLBSInvoiceNo,\nci.PLBSInvoiceDate,\nci.PLBSPrice,\nci.PLBSTax,\nci.PLBSTotal,\nci.DLBSBatchId,\nci.DLBSInvoiceNo,\nci.DLBSInvoiceDate,\nci.DLBSPrice,\nci.DLBSTax,\nci.DLBSTotal,\nci.LineHaulPrice,\nci.LineHaulTax,\nci.LineHaulTotal,\nci.[Zone],\ncis.SatchelSize,\ncis.WeightPriceTypeId,\nci.SubDepot,\nci.ToRfSubDepotCode,\nci.BareProfileId,\ncon.UpdatedOn as ConUpdatedOn,\nci.UpdatedOn as ConItemUpdatedOn,\ncis.Price AS ItemSumPrice,\ncis.Tax AS ItemSumTax,\ncis.Total AS ItemSumTotal,\ncis.PackageTypeId AS ItemSumPackageTypeId,\nci.LabelExternal\n--cis.DescriptionOfGoods as ItemSumDescriptionOfGoods,\n--cis.DeclaredValue,\n--cis.HSCodeInternal,\n--cis.HSCodeExternal\nFROM [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK) \nJOIN [FWFastlabel].[dbo].[fl_ConItemSum] cis with (NOLOCK) on cis.ConId = con.ConId\nJOIN [FWFastlabel].[dbo].[fl_ConItem] ci with (NOLOCK) on ci.ConId = cis.ConId and ci.[LineNo] = cis.[LineNo]\nWHERE con.ConId >= @ConId\n  AND con.ConId < @EndConId\n  AND con.RealisedDate IS NOT NULL",
