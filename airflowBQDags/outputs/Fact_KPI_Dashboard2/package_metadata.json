                    "component_type": "Microsoft.OLEDBSource",
                    "component_info": {
                      "sql_command": "--DECLARE   @lastDateTime datetime = ?\n\n--select @lastDateTime = '2020-03-01', @endDateTime  = '2020-07-20'\n\nDECLARE @StartDateOnly datetime = DATEADD(DAY,-4, SYSDATETIME());\nDECLARE @endDateOnly datetime = DATEADD(MINUTE,-5, SYSDATETIME());\n\n--SET @StartDate = CONVERT(varchar(10),EOMONTH(DATEADD(MONTH, -1, @startDate )),120)+'T23:59:59.999';\n\n\nSELECT \n    a.ID,\n    a.RecordId,\n    a.CountryCode,\n    a.FranchiseeCode,\n    a.ScanType,\n    a.[Status] AS ScanStatus,\n    a.LabelNo,\n    a.ScanDate,\n    a.CourierNo,\n    a.UploadDate,\n    a.RecordCreateDate,\n    a.iLocate\n    FROM FastwayReports.dbo.TrackAndTrace_7Day a (nolock)\n    --FROM FastwayReports.dbo.TrackAndTraceData (nolock)\n    WHERE Countrycode = 1  -- in (1,6,11,24) \n      AND Convert(date,RecordCreateDate) >= @StartDateOnly AND Convert(date,RecordCreateDate) <= @endDateOnly",
