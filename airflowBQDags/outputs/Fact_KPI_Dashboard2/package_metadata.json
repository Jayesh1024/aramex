                    "component_type": "Microsoft.OLEDBSource",
                    "component_info": {
                      "sql_command": "--DECLARE @startDate datetime = ?;\n\n--DECLARE @startDate datetime2(3) = '2023-04-02T00:00:00';\n--DECLARE @endDate datetime2(3) = '2023-02-17T08:00:00';\n\nSET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;\n\n\nDECLARE @startDate datetime2(3)\n\nSET @StartDate = CONVERT(varchar(10),EOMONTH(DATEADD(MONTH, -2, Getdate() )),120)+'T23:59:59.999';\n\nSELECT \nci.[Label],\ncon.CountryId,\nci.FromRf,\nci.FromCf,\nci.ToRf,\nci.ToCf,\ncon.ToLocality,\ncon.ToPostalCode,\n              con.RealisedDate,\n              ci.[Zone],\n  con.CreatedOn,\ncon.CustomerId\nFROM [FWFastlabel].[dbo].[fl_Con] con\nJOIN [FWFastlabel].[dbo].[fl_ConItemSum] cis on cis.ConId = con.ConId\nJOIN [FWFastlabel].[dbo].[fl_ConItem] ci on ci.ConId = cis.ConId and ci.[LineNo] = cis.[LineNo]\nWHERE con.CreatedOn > @startDate\n  AND Con.[RealisedDate] IS NOT NULL",
