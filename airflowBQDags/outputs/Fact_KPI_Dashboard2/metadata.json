              "per_component_data": {
                "Package\\Staging\\Staging 3\\Load fl_ConItemSrv_Stg\\fl_ConItemSrv (Fastway)": {
                  "component_type": "Microsoft.OLEDBSource",
                  "component_info": {
                    "sql_command": "DECLARE @startDate datetime = ?;\nDECLARE @startDate2 datetime;\n\nSET @StartDate2 = CONVERT(varchar(10),DATEADD(DAY, -1, Getdate()),120)+'T23:59:59.999';\n\n\nSELECT ci.[Label]\n      ,cis.[ConId]\n      ,cis.[ConItemId]\n      ,ci.[LineNo]\n      ,ci.[CountryId]\n      ,con.[CreatedOn]\n      ,cis.[ProductId]\n      ,cis.[ServiceItemId]\n      ,cis.[FMSInvoiceNo]\n      ,cis.[FMSInvoiceDate]\n      ,cis.[Price]\n      ,cis.[Tax]\n      \n,cis.[Total]\n      ,cis.[PickUpPrice]\n      ,cis.[DeliveryPrice]\n    ,cis.[DLBSBatchId]\n    ,cis.[DLBSInvoiceDate]\n    ,cis.[DLBSInvoiceNo]\n    ,cis.[DLBSPrice]\n    ,cis.[DLBSTax]\n    ,cis.[DLBSTotal]\n    ,cis.[PLBSBatchId]\n    ,cis.[PLBSInvoiceDate]\n    ,cis.[PLBSInvoiceNo]\n    ,cis.[PLBSPrice]\n    ,cis.[PLBSTax]\n    ,cis.[PLBSTotal]\n    ,cis.[BareProfileId]\n    ,cis.[ServicePrice]\n    ,cis.[ServicePriceComm]\n    ,cis.[ServicePriceCommPercent]\n    ,cis.[ServicePriceDiscountFixed]\n    ,cis.[ServicePriceDiscountPercent]\n    ,cis.[UpdatedOn]\n  FROM  [FWFastlabel].[dbo].[fl_ConItemSrv] cis\n  INNER JOIN [FWFastlabel].[dbo].[fl_Con] con on con.ConId = cis.ConId\n  INNER JOIN [FWFastlabel].[dbo].[fl_ConItem] ci on ci.ConId = cis.ConId AND ci.ConItemId = cis.[ConItemId]\nWHERE con.[CreatedOn] > @startDate2",
                    "inline_positional_params": true,
