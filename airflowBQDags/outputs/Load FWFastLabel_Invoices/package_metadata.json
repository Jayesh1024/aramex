                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @FromDate DATETIME = ?\n/*\n  Invoices are read with a >= EnteredDate rather than >\n  meaning some invoices already in FastwayDW are re-read\n  by this query. these duplicates are removed later\n*/\nSELECT \n       [InvoiceHeaderId]\n      ,[BatchId]\n      ,[RF]\n      ,[ParentRF]\n      ,[CountryId]\n      ,[CustomerId]\n      ,[ParentCustomerId]\n      ,[InvoiceNo]\n      ,[InvoiceDate]\n      ,[Price]\n      ,[Tax]\n      ,[Total]\n      ,[GroupPrice]\n      ,[GroupTax]\n      ,[GroupTotal]\n      ,[Released]\n      ,[RFLegalEntity]\n      ,[ParentRFLegalEntity]\n      ,[CFLegalEntity]\n      ,[Level]\n      ,[BankProcess]\n      ,[ParentInvoiceHeaderId]\n      ,[CFOverride]\n      ,[CFOverrideBasePriceCommPercent]\n      ,[CFOverrideExcessPriceCommPercent]\n      ,[SelectedUI]\n      ,[EnterpriseFastlabelType]\n      ,[DueDate]\n      ,[CloseDate]\n      ,[TotalPaid]\n      ,[CourierNumber]\n      ,[GroupTaxExempt]\n  FROM [FWFastLabel].[dbo].[fl_InvoiceHeader]\nWHERE [InvoiceDate] >= @FromDate\n  AND [CountryId] IN(1,6)",
                  "connection_names": [
                    "Project.ConnectionManagers[KRILLIN_Fastway]"
