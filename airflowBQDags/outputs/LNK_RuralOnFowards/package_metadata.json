                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @LastDate date = ?\nDECLARE @StartDate date = ?\nDECLARE @EndDate date = ?;\n--If specified startdate and enddate are inclusive\n\nSET @StartDate  = IIF(@StartDate = '1900-01-01', DATEADD(DAY,1,@LastDate), @StartDate);\nSET @EndDate = IIF(@EndDate = '1900-01-01', CONVERT(date,DATEADD(DAY,-1,GetDate())), @EndDate);\n\n\nSELECT  [Country]\n      ,[RF]\n      ,[Courier]\n      ,[Label]\n      ,[Date]\n      ,[Time]\n      ,[Onforwards]\n      ,[FileId]\n  FROM [Fastway].[dbo].[LA_RuralOnforwards]\n  WHERE [Date] >= @StartDate AND [Date] <= @EndDate\nORDER BY Country, RF,Courier,Label,Date,Time",
