    "dataflow_heavy_etl": "Data Flow Tasks dominate movement.",
    "high_parallelism_staging": "Very many sequence branches / sources (e.g. large HUB packages).",
    "subpackage_orchestration": "Many Execute Package tasks coordinate other packages.",
    "maintenance_or_dba_tooling": "DB maintenance, copy, connectivity tests.",
    "export_or_reporting": "Export / reporting oriented names.",
    "interim_or_bridge_staging": "Interim fact/link staging.",
    "operational_load_orchestration": "LoadControl-style multi-package runners.",
    "domain_specific_incremental_load": "Domain-named incremental loads (invoices, RF, pricing).",
