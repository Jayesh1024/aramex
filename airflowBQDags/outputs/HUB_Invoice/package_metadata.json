                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @FromDate DATETIME = ?\n/*\n  Invoices are read with a >= SystemDate rather than >\n  meaning some invoices already in FastwayDW are re-read\n  by this query. these duplicates are removed later\n*/\nSELECT [RFCode]\n      ,[InvoiceNumber]\n      ,[ProductId]\n      ,[IssueOrReceipt]\n      ,[Label]\n      ,[CustomerId]\n      ,[CourierId]\n      ,[NMId]\n  FROM [Fastway].[dbo].[FMS_InvoiceBooks] as stg\n  WHERE EXISTS (\n      select 1 from [Fastway].[dbo].[FMS_InvoiceHead] h \n              where h.EnteredDate >= @FromDate\n\tand h.InvoiceNumber = stg.InvoiceNumber \n\tand h.RFCode = stg.RFCode\n                   and h.[NMId] in (1,6) \n  )",
