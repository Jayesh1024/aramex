                    "sql_command_variable": "SourceDataQuery_tsections",
                    "open_rowset_variable_qualified": null,
                    "sql_command_variable_qualified": "User::SourceDataQuery_tsections",
                    "variables_used_distinct": [
                      "LastId",
                      "SourceDataQuery_tsections"
                    ]
                  }
                }
