              "Package\\Staging\\Load TrackAndTrace_Stg\\TrackAndTrace data (Fastway)": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE\n    @lastId bigint = ?,\n    @endID bigint,\n    @boundDate datetime;\n\nSET @boundDate  = DATEADD(D,-30, GETDATE()) \nSET @EndID = @lastID +  200000; -- Batchsize - rows every 15min\n\n\nSELECT\n\ta.ID,\n\ta.RecordId,\n\ta.CountryCode,\n\ta.FranchiseeCode,\n\ta.ScanType,\n\ta.ScanStatus,\n\ta.LabelNo,\n\ta.ScanDate,\n\ta.CourierNo,\n\ta.CountryName,\n\ta.UploadDate,\n\ta.RecordCreateDate,\n\ta.iLocate,\n\ta.ProductId,\n\ta.Latitude,\n\ta.Longitude,\n    a.[Signature]\n\tFROM (\n\t\tSELECT\n\t\tID,\n\t\tRecordId,\n\t\tCountryCode,\n\t\tFranchiseeCode,\n\t\tScanType,\n\t\t[Status] as ScanStatus,\n\t\tLabelNo,\n\t\tScanDate,\n\t\tCourierNo,\n\t\t'' AS CountryName,\n\t\tUploadDate,\n\t\tRecordCreateDate,\n\t\tiLocate,\n \t\tProductId,   \n\t\tLatitude,\n\t\tLongitude,\n\t\t[Signature]\n\n\t\tFROM FastwayReports.[dbo].TrackAndTraceDataP Part (READPAST)\n\t\tWHERE ScanDate > @boundDate\n                                        AND ID > @lastID AND ID <= @endID\n\t\t    AND Countrycode in (1,6,11,24)\n\t) a\nORDER BY ID\nOPTION (Recompile);",
                  "connection_names": [
                    "Project.ConnectionManagers[VEGETA_FastwayReports]"
                  ],
                  "inline_positional_params": true,
                  "inline_positional_params_mapping": {
                    "param_1": "LastId"
                  },
