              "Package\\Staging 2\\Load Label_Interbranch_Stg\\Load Label_Interbranch_Stg": {
                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "DECLARE @LastBatchID INT = ?;\nDECLARE @RecordSource varchar(50) = ?;\nDECLARE @Batchsize Int = 5000000;\nDECLARE @CountryCode Int = 0;\n\nIF @RecordSource = 'InterBranchAU'  SET @CountryCode = 1;\nIF @RecordSource = 'InterBranchNZ'  SET @CountryCode = 6;\n\nSET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;\n\nSELECT  TOP (@Batchsize)\n@CountryCode as 'CountryCode',\nCASE @CountryCode WHEN 1 THEN 'Australia' WHEN 6 THEN 'New Zealand' END AS [Country],\nd.[LabelNo],\nd.[Franchise] as 'InvoiceFromRF',\ni.[PickupRFCode] as 'InvoiceToRF',\nd.[BatchId],\n(CASE WHEN d.[Franchise] = i.PickupRFCode THEN 'Internal' ELSE 'Invoiced' END) as Category,\ni.[Date],\nd.[InvoiceNumber],\nd.ProductId ,\nconvert(date,d.[CourierDate]) as 'DeliveryDate',\nd.[CourierTime] as 'DeliveryTime',\nconvert(decimal(10,2),v.[DeliveryCostPerProduct]) as 'Price'\n\nFROM [Fastway].[dbo].invbtch b WITH (NOLOCK)\n\nINNER JOIN [invhead] i WITH (NOLOCK) on  b.BatchId = i.InvoiceBatchID and b.CountryCode = i.Country \nINNER JOIN  [Fastway].[dbo].[labels] d WITH (NOLOCK) ON ISNULL(d.BatchID,0) = b.BatchID and d.InvoiceNumber = i.InvoiceNumber and d.CountryCode = b.countryCode and d.InvoiceFranchiseAccountNumber = i.DeliveryFranchisee\nLEFT JOIN prods p WITH (NOLOCK) on d.ProductId = p.ProductId and d.CountryCode = p.CountryCode\nLEFT JOIN invdet v WITH (NOLOCK) on d.InvoiceNumber = v.InvoiceNumber and i.DeliveryFranchisee = v.DeliveryFranchisee and i.Country = v.CountryCode and p.LabelPrefix = v.Prefix\n\nWHERE b.CountryCode = @CountryCode  and d.PickupDelivery = 'D'\nAND b.BatchID = @LastBatchID\nAND b.released = 1",
                  "connection_names": [
                    "Project.ConnectionManagers[KRILLIN_Fastway]"
                  ],
                  "inline_positional_params": true,
                  "inline_positional_params_mapping": {
                    "param_1": "LastBatchId12",
                    "param_2": "(unresolved:{53115AA2-109F-4DD1-88F5-70660E6AD0C6})"
                  },
                  "variables_used": {
                    "open_rowset_variable": null,
                    "sql_command_variable": null,
                    "open_rowset_variable_qualified": null,
                    "sql_command_variable_qualified": null,
                    "variables_used_distinct": [
                      "LastBatchId12"
                    ]
                  }
                }
