          "per_component_data": {
            "Package\\Staging 2\\Load Label_Interbranch_Stg\\Label_Interbranch_Stg": {
              "component_type": "Microsoft.OLEDBDestination",
              "component_info": {
                "table_name": "Label_Interbranch_Stg",
