                "component_type": "Microsoft.OLEDBSource",
                "component_info": {
                  "sql_command": "SELECT\n    c.[RFCode],\n    [CourierNumber],\n    g.[Description] as CourierGroup,\n    [Name],\n    [ShortName],\n    [CFName],\n    [Address1],\n    [Address2],\n    [Address3],\n    [Address4],\n    [EmailAddress],\n    [PhoneNumber],\n    [Mobile],\n    [BlackbayRouteId],\n    w.[Description] AS CFOwnershipModel,\n    c.[Inactive],\n    ParcelConnectCFTerritory\nFROM [Fastway].[dbo].[FMS_Courier] c\n         left join [FMS_LookUpTableDetail] g ON c.RFCode = g.RFCode AND HeaderCode = 'GRP' AND c.CourierGroup = g.ItemCode\n         left join [FMS_LookUpTableDetail] w ON w.HeaderCode = 'OWN' AND w.ItemCode = c.CFOwnershipModel AND c.NMid = w.NMid\nWHERE Inactive = 0;",
                  "connection_names": [
                    "Project.ConnectionManagers[KRILLIN_Fastway]"
                  ],
