                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=14.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastDate date = ?
DECLARE @StartDate date = ?
DECLARE @EndDate date = ?;
--If specified startdate and enddate are inclusive

SET @StartDate  = IIF(@StartDate = '1900-01-01', DATEADD(DAY,1,@LastDate), @StartDate);
SET @EndDate = IIF(@EndDate = '1900-01-01', CONVERT(date,DATEADD(DAY,-1,GetDate())), @EndDate);


SELECT  [Country]
      ,[RF]
      ,[Courier]
      ,[Label]
      ,[Date]
      ,[Time]
      ,[Onforwards]
      ,[FileId]
  FROM [Fastway].[dbo].[LA_RuralOnforwards]
  WHERE [Date] &gt;= @StartDate AND [Date] &lt;= @EndDate
ORDER BY Country, RF,Courier,Label,Date,Time</property>
