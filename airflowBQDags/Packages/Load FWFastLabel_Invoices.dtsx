                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @FromDate DATETIME = ?
/*
  Invoices are read with a &gt;= EnteredDate rather than &gt;
  meaning some invoices already in FastwayDW are re-read
  by this query. these duplicates are removed later
*/
SELECT 
       [InvoiceHeaderId]
      ,[BatchId]
      ,[RF]
      ,[ParentRF]
      ,[CountryId]
      ,[CustomerId]
      ,[ParentCustomerId]
      ,[InvoiceNo]
      ,[InvoiceDate]
      ,[Price]
      ,[Tax]
      ,[Total]
      ,[GroupPrice]
      ,[GroupTax]
      ,[GroupTotal]
      ,[Released]
      ,[RFLegalEntity]
      ,[ParentRFLegalEntity]
      ,[CFLegalEntity]
      ,[Level]
      ,[BankProcess]
      ,[ParentInvoiceHeaderId]
      ,[CFOverride]
      ,[CFOverrideBasePriceCommPercent]
      ,[CFOverrideExcessPriceCommPercent]
      ,[SelectedUI]
      ,[EnterpriseFastlabelType]
      ,[DueDate]
      ,[CloseDate]
      ,[TotalPaid]
      ,[CourierNumber]
      ,[GroupTaxExempt]
  FROM [FWFastLabel].[dbo].[fl_InvoiceHeader]
WHERE [InvoiceDate] &gt;= @FromDate
  AND [CountryId] IN(1,6)</property>
