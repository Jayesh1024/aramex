                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastDate datetime = ?;
--DECLARE @LastID int = 0;


--SET @LastID = COALESCE(@LastID, 0);

--SELECT @LastID = COALESCE(MIN([ZenDeskTicketId]), 0 )
--  FROM [Fastway].[dbo].[ZEN_Tickets]
--WHERE [SysLastUpdatedUtc] &gt; @LastDate


SELECT 
       [ZenDeskTicketId]
      ,[LabelNo]
      ,[Subject]
      ,[CreatedDate]
      ,[CreatedTime]
      ,[TicketType]
      ,[Issue]
      ,[Solved]
      ,[SysLastUpdatedUtc]
  FROM [Fastway].[dbo].[ZEN_Tickets]
WHERE  [SysLastUpdatedUtc] &gt; @LastDate</property>
