            <SQLTask:SqlTaskData
              SQLTask:Connection="{66292261-9521-45A6-ACCA-54377A482A00}"
              SQLTask:SqlStatementSource="Declare @ProcessId Int;&#xA;SELECT @ProcessId = max(ProcessId) FROM [Staging].[LoadLog] &#xA;SELECT Isnull(@ProcessId,0) +1 AS [NextProcessId] "
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="NextProcessId"
