                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[prods]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	[CountryCode], 
	[Country2] = CONVERT( VARCHAR(100), REPLACE(ISNULL(c.Country,p.CountryCode),'  ','') ), 
	[ProductId], 
	p.[Code], 
	[Description], 
	[Price], 
	[QtyOnHand], 
	[QtyCommitted], 
	[ItemType], 
	[LabelPrefix], 
	[BooksPerPackOrCarton], 
	[LabelsPerBook], 
	[FMSBookPrice], 
	[FMSDeliveryPrice], 
	[FMSPickupPrice], 
	[FMSCommission], 
	[IncludesGST], 
	[FMSSalesType], 
	[MinimumStockLevel], 
	[QTYOnBackOrder], 
	[LastLandedUnitCost], 
	[PackPrice], 
	[PacksInOpenCartons], 
	[DormantItem], 
	[ProductCategory], 
	[DestinationLabelCost], 
	[DestinationLabelCostA], 
	[DestinationLabelCostB], 
	[DestinationLabelCostc], 
	[DeliveryNumberofDays], 
	[OldProductCode], 
	[NotSoldByFSO], 
	[MYOBAccountNo], 
	[UsualSupplierId], 
	[NMOrderingComments], 
	[SuppliersCode], 
	[SuppliersDescription], 
	[SupplierPrice], 
	[InterRFProduct], 
	[EnterpriseFastLabelColor], 
	[Supplementary], 
	[AramexProduct], 
	[FSOONFCharge],
                  [SAPGroup],
                  [SAPProductGroup],
                  [SAPSubProduct]

FROM [Fastway].[dbo].[prods] p 
LEFT JOIN [Fastway].[dbo].[Country] c ON c.Code = p.CountryCode</property>
