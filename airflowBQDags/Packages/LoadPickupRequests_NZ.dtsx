      ,[PickupSpecialInstructions]
      ,[DeliverySpecialInstructions]
      ,[HhcMessageId]
      ,[HasCourierRejected]
      ,[IsRegularCollection]
      ,[RequestingCustomerOesId]
      ,[IsCancelled]
