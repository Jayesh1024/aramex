      ,[CancellationTitle]
      ,[FutileScanDate]
      ,[NotReadyScanDate]
      ,[PickupScanDate]
      ,[MessageSentDateUtc]
      ,[CourierMessageResultText]
      ,[RejectionReason]
      ,[RejectionDate]
      ,[InternalStatus]
      ,[DidNotAssignCourierDuringCreation]
      ,[IsReturnService]
      ,[IsParcelConnectPickupLocation]
      ,[SecondaryLabelNumber]
      ,[PickupSubDepotFranchiseeCode]
      ,[CubicWeight]
      ,[PickupCompany]
      ,[DeliveryCompany]
      ,[IsPriority]
  FROM CHANGETABLE (CHANGES [FastwayGlobal_6].[PickupDashboard].[PickupRequest], @Last_synced_version) Cng 	
  LEFT JOIN [FastwayGlobal_6].[PickupDashboard].[PickupRequest] AS CNC ON Cng.ID = CNC.Id
  WHERE @IsReload = 0
 AND  [SYS_CHANGE_OPERATION] != 'D'

  UNION
  SELECT [Id]
      ,@minimumVersion AS [SYS_CHANGE_VERSION]
      ,'I' AS [SYS_CHANGE_OPERATION]
