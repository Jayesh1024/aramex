                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @Last_synced_version bigint = ?;
DECLARE @IsReload bit = ?;
DECLARE @minimumVersion  bigint;
USE [FastwayGlobal_6]

SET @minimumVersion  = CHANGE_TRACKING_MIN_VALID_VERSION(OBJECT_ID('[PickupDashboard].[PickupRequest]'))

IF (@Last_synced_version  &lt; @minimumVersion AND @IsReload  = 0)  RAISERROR('ERROR - Synchronization version invalid', 11, 11);


SELECT Cng.[Id]
      ,Cng.[SYS_CHANGE_VERSION]
      ,Cng.[SYS_CHANGE_OPERATION]
      ,[CreateDateUtc]
      ,[ShouldPrintLabel]
      ,[PickupFranchiseeCode]
      ,[PickupCourierNumber]
      ,[LabelNumber]
