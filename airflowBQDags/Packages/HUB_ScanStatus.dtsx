                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[status]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	[CountryCode], 
	isnull(ct.Country,'Unknown') as CountryName, 
	st.[Code] as StatusCode, 
	[Description], 
	[ExtendedDescription], 
	[ShowToCustomer], 
	[Misdirected], 
	[LeftByCF], 
	[Undeliverable], 
	[CageScan], 
	[BBForceToTScan], 
	[DontSendToBB], 
	[CanSelectInRunsheetScanning], 
	[HeaderGroup], 
	[CFBayScan], 
	[ContainerScan],
	[Active],
                  [ForcedScanType],
                  [ExcludeFromMFYBilling],
                  [ImpactStatus],
                  [Pickup],
                  [PickupRF],
                  [DeliveryRF],
                  [Delivered],
                  [PrePickup],
                  [Problem],
                  [AttemptedDelivery],
                  [CollectionRequired],
                  [Onforward],
                  [Delayed],
                  [ReadyToCollect]
FROM [Fastway].[dbo].[status] st 
LEFT JOIN [Fastway].[dbo].[Country] ct ON ct.Code = st.CountryCode</property>
