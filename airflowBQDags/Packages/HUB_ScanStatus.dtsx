      DTS:Namespace="User"
      DTS:ObjectName="SourceDataQuery">
      <DTS:VariableValue
        DTS:DataType="8">SELECT [CountryCode], isnull(ct.Country,'Unknown') as CountryName, st.[Code] as StatusCode, [Description], [ExtendedDescription], [ShowToCustomer], [Misdirected], [LeftByCF], [Undeliverable], [CageScan], [BBForceToTScan], [DontSendToBB], [CanSelectInRunsheetScanning], [HeaderGroup], [CFBayScan], [ContainerScan] FROM [Fastway].[dbo].[status] st LEFT JOIN [Fastway].[dbo].[Country] ct ON ct.Code = st.CountryCode</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
