              SQLTask:SqlStatementSource="SET DEADLOCK_PRIORITY 2;&#xA;&#xA;ALTER INDEX [IX_AddressHSK] ON [Staging].[Label_Address_Stg] REBUILD;&#xA;&#xA;--Mashup causing load to fail with this index rebuild as the deadlock victim. Want mashup to be the victim&#xA;&#xA;--EXEC [dbo].[MaintainIndexes] @Operation = 'REBUILD', @SchemaName = 'Staging', @TableName = 'Label_Address_Stg';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
