                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @synchronization_version bigint = ?;

IF (@synchronization_version &lt; CHANGE_TRACKING_MIN_VALID_VERSION(OBJECT_ID('dbo.payzone_regions')))  RAISERROR('ERROR - Synchronization version invalid', 11, 11);

SELECT [id]
      ,[region_id]
      ,[courier_no]
      ,[store_identifier]
      ,[store_name]
      ,[store_address1]
      ,[store_latitude]
      ,[store_longitude]
      ,[store_address2]
      ,[store_town]
      ,[store_county]
      ,[store_active]
      ,[is_test]
      ,[Postcode]
      ,[MyLocateCode]
      ,[ApplicationFormReceived]
      ,[SignedAgreementReceived]
      ,[InsuranceCertificateSupplied]
      ,[TradingHours]
      ,[PhoneNo]
      ,[NotificationSent]
      ,[CreatedBy]
      ,[CreatedByCountry]
      ,[UserId]
      ,[ApplicationId]
      ,[Hubbed]
      ,[AllowFwClickAndCollect]
      ,[MaxWeightDead]
      ,[DimensionCombinedMax]
      ,[store_state]
      ,[SYS_CHANGE_VERSION]
      ,[SYS_CHANGE_OPERATION]
  FROM CHANGETABLE (CHANGES payzone_agents, @synchronization_version) Cng 	
  LEFT JOIN [OnlineEnquiries_NEW].[dbo].[payzone_agents] AS PR ON Cng.ID = CNC.Id</property>
