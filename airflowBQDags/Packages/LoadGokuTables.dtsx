                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @synchronization_version bigint = ?;
DECLARE @minimumVersion bigint; 
DECLARE @IsReload bit = ?;

SET @minimumVersion  = CHANGE_TRACKING_MIN_VALID_VERSION(OBJECT_ID('dbo.payzone_regions'))

IF (@synchronization_version &lt; @minimumVersion  AND @IsReload  = 0 ) RAISERROR('ERROR - Synchronization version invalid', 11, 11);

SELECT Src.[id]
      ,[franchisee_code]
      ,[region_company_name]
      ,[region_company_phone]
      ,[region_address]
      ,[region_company_email]
      ,[secondary_franchisee_codes]
      ,[CountryId]
      ,[SYS_CHANGE_VERSION]
      ,[SYS_CHANGE_OPERATION]
  FROM CHANGETABLE (CHANGES payzone_regions, @synchronization_version) Cng 	
  LEFT JOIN [OnlineEnquiries_NEW].[dbo].[payzone_regions] AS Src ON Cng.ID = Src.Id
  WHERE @IsReload = 0

  UNION
  SELECT [id]
      ,[franchisee_code]
      ,[region_company_name]
      ,[region_company_phone]
      ,[region_address]
      ,[region_company_email]
      ,[secondary_franchisee_codes]
      ,[CountryId]
      ,@minimumVersion AS [SYS_CHANGE_VERSION]
      ,'I' AS [SYS_CHANGE_OPERATION]
  FROM [OnlineEnquiries_NEW].[dbo].[payzone_regions] AS Src
  WHERE @IsReload = 1</property>
