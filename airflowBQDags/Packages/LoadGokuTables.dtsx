                  description="OLE DB Source"
                  name="Get Payzone Agents"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[payzone_agents]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @synchronization_version bigint = ?;
DECLARE @minimumVersion bigint; 
DECLARE @IsReload bit = ?;

SET @minimumVersion  = CHANGE_TRACKING_MIN_VALID_VERSION(OBJECT_ID('dbo.payzone_agents'))

IF (@synchronization_version &lt; @minimumVersion  AND @IsReload  = 0 )  RAISERROR('ERROR - Synchronization version invalid', 11, 11);

SELECT Src.[id]
      ,[region_id]
      ,[courier_no]
      ,[store_identifier]
      ,[store_name]
      ,[store_address1]
      ,[store_latitude]
      ,[store_longitude]
      ,[store_address2]
      ,[store_town]
      ,[store_county]
      ,[store_active]
      ,[is_test]
      ,[Postcode]
      ,[MyLocateCode]
      ,[ApplicationFormReceived]
      ,[SignedAgreementReceived]
      ,[InsuranceCertificateSupplied]
      ,[TradingHours]
      ,[PhoneNo]
      ,[NotificationSent]
      ,[CreatedBy]
      ,[CreatedByCountry]
      ,[UserId]
      ,[ApplicationId]
      ,[Hubbed]
      ,[AllowFwClickAndCollect]
      ,[MaxWeightDead]
      ,[DimensionCombinedMax]
      ,[store_state]
      ,[SYS_CHANGE_VERSION]
      ,[SYS_CHANGE_OPERATION]
  FROM CHANGETABLE (CHANGES payzone_agents, @synchronization_version) Cng 	
  LEFT JOIN [OnlineEnquiries_NEW].[dbo].[payzone_agents] AS Src ON Cng.ID = Src.Id
  WHERE @IsReload = 0

UNION
SELECT [id]
      ,[region_id]
      ,[courier_no]
      ,[store_identifier]
      ,[store_name]
      ,[store_address1]
      ,[store_latitude]
      ,[store_longitude]
      ,[store_address2]
      ,[store_town]
      ,[store_county]
      ,[store_active]
      ,[is_test]
      ,[Postcode]
      ,[MyLocateCode]
      ,[ApplicationFormReceived]
      ,[SignedAgreementReceived]
      ,[InsuranceCertificateSupplied]
      ,[TradingHours]
      ,[PhoneNo]
      ,[NotificationSent]
      ,[CreatedBy]
      ,[CreatedByCountry]
      ,[UserId]
      ,[ApplicationId]
      ,[Hubbed]
      ,[AllowFwClickAndCollect]
      ,[MaxWeightDead]
      ,[DimensionCombinedMax]
      ,[store_state]
      , @minimumVersion AS [SYS_CHANGE_VERSION]
      ,'I' AS [SYS_CHANGE_OPERATION]
  FROM [OnlineEnquiries_NEW].[dbo].[payzone_agents] AS Src
  WHERE @IsReload = 1</property>
