                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @FromDate DATETIME = ?
/*
  Invoices are read with a &gt;= EnteredDate rather than &gt;
  meaning some invoices already in FastwayDW are re-read
  by this query. these duplicates are removed later
*/
SELECT 
       [RFCode]
      ,[InvoiceNumber]
      ,[EnteredDate]
      ,[EnterTime]
      ,[CourierInvoiceBelongsTo]
      ,[CustomerId]
      ,[CourierIdCommisionPaidTo]
      ,[InvoiceTotalAmount]
      ,[TaxAmount]
      ,[AmountPaid]
      ,[Balance]
      ,[PaidOnEntry]
      ,[InsuranceAmount]
      ,[DissectionLines]
      ,[CourierFloatIssuesGoTo]
      ,[FullyPaid]
      ,[Committed]
      ,[NMId]
      ,[InvoiceCopyDate]
      ,[BatchId]
      ,[SystemDate]
      ,[CreditedAmount]
      ,[CreditedTax]
      ,[PurchaseOrderNumber]
      ,[Comments]
      ,[ExcludedFromBaseRate]
  FROM [Fastway].[dbo].[FMS_InvoiceHead]
WHERE [EnteredDate] &gt;= @FromDate
  AND [NMId] IN(1,6)</property>
