          DTS:ObjectName="Load fl_ConItem_Stg"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Source4 (MyFastway) _MF\Load fl_ConItem_Stg\fl_ConItem (Fastway)"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="fl_ConItem (Fastway)"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @startDate datetime = '1900-01-01 00:00:00';
DECLARE @BatchDays int = -120;
DECLARE @endDate datetime = @startDate;
DECLARE  @ConId bigint;
DECLARE  @EndConId bigint;

IF (@StartDate = '1900-01-01 00:00:00' )
	BEGIN
		SET @startDate = DATEADD(DAY, @BatchDays, Getdate()); 
		SET @endDate = Getdate(); 
	END	
ELSE 
	SET @startDate = DATEADD(DAY, @BatchDays, Getdate()); 

SELECT TOP 1 @ConId = ConId
FROM [FWFastlabel].dbo.fl_Con (NOLOCK)
WHERE CreatedOn &gt;= @startDate
ORDER BY CreatedOn

SELECT TOP 1 @EndConId = ConId
FROM [FWFastlabel].dbo.fl_Con (NOLOCK)
WHERE CreatedOn &lt;= @endDate  
ORDER BY CreatedOn desc


SELECT
ci.[Label],
con.ConId,
ci.ConItemId,
ci.[LineNo],
con.CountryId,
con.CreatedOn,
con.CustomerId,
ci.FromRf,
ci.FromCf,
ci.ToRf,
ci.ToCf,
ci.FMSInvoiceNo,
ci.FMSInvoiceDate,
cis.Reference,
cis.Quantity,
cis.ProductId,
cis.WeightDead,
cis.WeightCubic,
cis.WeightPriced,
cis.Width,
cis.Length,
cis.Height,
con.FromBusinessName,
con.FromContactName,
con.FromStreetAddress,
con.FromLocality,
con.FromStateOrProvince,
con.FromPostalCode,
con.FromCountry,
con.FromPhoneNumber,
con.FromEmail,
con.FromLat,
con.FromLng,
con.ToBusinessName,
con.ToContactName,
con.ToStreetAddress,
con.ToLocality,
con.ToStateOrProvince,
con.ToPostalCode,
con.ToCountry,
con.ToPhoneNumber,
con.ToEmail,
con.ToLat,
con.ToLng,
con.RealisedDate,
ci.RealisedDate as ItemRealisedDate,
ci.BasePrice,
ci.ExcessPrice,
ci.PickUpPriceTotal,
ci.DeliveryPriceTotal,
ci.BasePriceComm,
ci.ExcessPriceComm,
ci.BasePriceDiscounted,
ci.ExcessPriceDiscounted,
ci.ItemPrice,
ci.ServicePrice,
ci.PLBSBatchId,
ci.PLBSInvoiceNo,
ci.PLBSInvoiceDate,
ci.PLBSPrice,
ci.PLBSTax,
ci.PLBSTotal,
ci.DLBSBatchId,
ci.DLBSInvoiceNo,
ci.DLBSInvoiceDate,
ci.DLBSPrice,
ci.DLBSTax,
ci.DLBSTotal,
ci.LineHaulPrice,
ci.LineHaulTax,
ci.LineHaulTotal,
ci.[Zone],
cis.SatchelSize,
cis.WeightPriceTypeId,
ci.SubDepot,
ci.ToRfSubDepotCode,
ci.BareProfileId,
con.UpdatedOn as ConUpdatedOn,
ci.UpdatedOn as ConItemUpdatedOn,
cis.Price AS ItemSumPrice,
cis.Tax AS ItemSumTax,
cis.Total AS ItemSumTotal,
cis.PackageTypeId AS ItemSumPackageTypeId,
ci.LabelExternal
--cis.DescriptionOfGoods as ItemSumDescriptionOfGoods,
--cis.DeclaredValue,
--cis.HSCodeInternal,
--cis.HSCodeExternal
FROM [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK) 
JOIN [FWFastlabel].[dbo].[fl_ConItemSum] cis with (NOLOCK) on cis.ConId = con.ConId
JOIN [FWFastlabel].[dbo].[fl_ConItem] ci with (NOLOCK) on ci.ConId = cis.ConId and ci.[LineNo] = cis.[LineNo]
WHERE con.ConId &gt;= @ConId
  AND con.ConId &lt; @EndConId
  AND con.RealisedDate IS NOT NULL</property>
                    <property
