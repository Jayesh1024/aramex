}

public class Variables
{
    ScriptComponent ParentComponent;

    public Variables(ScriptComponent Component)
    {
        ParentComponent = Component;
    }

    public String PackageName
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["PackageName"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

    public Int64 ProcessId
    {
        get
        {
            return (Int64)(ParentComponent.ReadOnlyVariables["ProcessId"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

    public String RecordSource4
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["RecordSource4"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

}
]]></arrayElement>
