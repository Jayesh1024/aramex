                    <component
                      refId="Package\Staging\Source13 (PickupRequests)\Load Pickup Requests (NZ)\Load Pickup Requests NZ"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="Load Pickup Requests NZ"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset">[dbo].[LA_RuralOnforwards]</property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @startDate datetime = DATEADD(DAY,-60,getdate())
DECLARE @NextID INT;

SELECT TOP 1 @NextID = ID  FROM [FastwayGlobal_6].[PickupDashboard].[PickupRequest]
  WHERE [CreateDateUtc] &gt; @startDate
 ORDER BY [CreateDateUtc] 

SELECT [Id]

      ,[CreateDateUtc]
      ,[ShouldPrintLabel]
      ,[PickupFranchiseeCode]
      ,[PickupCourierNumber]
      ,[LabelNumber]
      ,[CollectionDate]
      ,[CollectionCycle]
      ,[PickupAddress1]
      ,[PickupAddress2]
      ,[PickupSuburb]
      ,[PickupPostcode]
      ,[PickupName]
      ,[PickupPhone]
      ,[PickupEmail]
      ,[DeliveryAddress1]
      ,[DeliveryAddress2]
      ,[DeliverySuburb]
      ,[DeliveryPostcode]
      ,[DeliveryName]
      ,[DeliveryPhone]
      ,[DeliveryEmail]
      ,[IsMessageSent]
      ,[Weight]
      ,[Width]
      ,[Height]
      ,[Length]
      ,[RequestingCustomerName]
      ,[CountryCode]
      ,[IsPrinted]
      ,[IsComplete]
      ,[ConsolidationGroupId]
      ,[CourierMessageResult]
      ,[ConsolidationDateUtc]
      ,[PickupSpecialInstructions]
      ,[DeliverySpecialInstructions]
      ,[HhcMessageId]
      ,[HasCourierRejected]
      ,[IsRegularCollection]
      ,[RequestingCustomerOesId]
      ,[IsCancelled]
      ,[CancellationReason]
      ,[CancellationTitle]
      ,[FutileScanDate]
      ,[NotReadyScanDate]
      ,[PickupScanDate]
      ,[MessageSentDateUtc]
      ,[CourierMessageResultText]
      ,[RejectionReason]
      ,[RejectionDate]
      ,[InternalStatus]
      ,[DidNotAssignCourierDuringCreation]
      ,[IsReturnService]
      ,[IsParcelConnectPickupLocation]
      ,[SecondaryLabelNumber]
      ,[PickupSubDepotFranchiseeCode]
      ,[CubicWeight]
      ,[PickupCompany]
      ,[DeliveryCompany]
      ,[IsPriority]
  FROM [FastwayGlobal_6].[PickupDashboard].[PickupRequest]
  WHERE [ID] &gt;= @NextID</property>
