                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @startDate datetime = ?
SET @startDate = DATEADD(DD,-1,@startDate)
--SET @StartDate = '2022-06-01T00:00:00'

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT 
	d.LabelNumber, 
	d.CountryCode, 
	d.CreateDate, 
	d.LabelPrinted, 
	d.CustomerID, 
	d.ClientID, 
	d.ConsumedByCustomerUserID, 
	d.LblColour, 
	d.LblPrice, 
	d.LblPrice1,
	i.Reference, 
	i.Packaging, 
	i.Weight, 
	i.WeightCubic, 
	i.Length, 
	i.Width, 
	i.Height, 
	b.ManifestID, 
	b.Address1,
	b.Address2,
	b.Town, 
	b.PostCode, 
	b.State, 
	b.destRF,
	d.BookID,
                  d.DateConsumed,
                  i.ConsignmentID
FROM [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Book_Detail] d
LEFT JOIN [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Consignment_Items] i on d.AppliedToItemID = i.ItemID
LEFT JOIN [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Consignment] b on i.ConsignmentID = b.ConsignmentID
WHERE d.CreateDate &gt; @startDate OR d.DateConsumed &gt; @startDate;</property>
