                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @NextID int = ?
--SET @StartDate = '2022-06-01T00:00:00'


SELECT 
    LabelNo, 
    CountryCode, 
    DateInserted, 
    ConDate, 
    SendAdd1, SendAdd2, SendAdd3, SendAdd4, SendAdd5, SendAdd6,
    RecAdd1, RecAdd2, RecAdd3, RecAdd4, RecAdd5, RecAdd6,
    CollectionPostCode, CollectionCountryCode, 
    DeliveryPostCode, DeliveryCountryCode,
    ManifestId, 
    ClientId, 
    CustomerID, 
    Quantity, 
    Weight, 
    Width, 
    Length, 
    Height, 
    CollectionRF, 
    DeliveryRF, 
    RecordId,
    UniqueParcelIdentifier
FROM [Fastway].[dbo].[HDManifests] WITH (READPAST, INDEX = RecordId)
WHERE RecordId &gt;= @NextID ;</property>
