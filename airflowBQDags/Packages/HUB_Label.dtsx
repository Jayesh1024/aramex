            <DTS:Executable
              DTS:refId="Package\Staging\Source11 (MyFastwaySrv) _MF 2\Load fl_ConItemSrv_Stg"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{b8a9c7f9-7fc8-4ee2-8196-4524d7e53b8a}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Load fl_ConItemSrv_Stg"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\Staging\Source11 (MyFastwaySrv) _MF 2\Load fl_ConItemSrv_Stg\fl_ConItemSrv (Fastway)"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="fl_ConItemSrv (Fastway)"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @startDate datetime = ?;
DECLARE @startDate2 datetime;
DECLARE  @ConId bigint;

SET @startDate2  = DATEADD(DAY, -30,GETDATE());

SELECT TOP 1 @ConId = ConId
FROM [FWFastlabel].dbo.fl_Con (NOLOCK)
WHERE CreatedOn &gt;= @StartDate2
ORDER BY CreatedOn

SELECT ci.[Label]
      ,cis.[ConId]
      ,cis.[ConItemId]
      ,ci.[LineNo]
      ,ci.[CountryId]
      ,con.[CreatedOn]
      ,cis.[ProductId]
      ,cis.[ServiceItemId]
      ,cis.[FMSInvoiceNo]
      ,cis.[FMSInvoiceDate]
      ,cis.[Price]
      ,cis.[Tax]
      
,cis.[Total]
      ,cis.[PickUpPrice]
      ,cis.[DeliveryPrice]
    ,cis.[DLBSBatchId]
    ,cis.[DLBSInvoiceDate]
    ,cis.[DLBSInvoiceNo]
    ,cis.[DLBSPrice]
    ,cis.[DLBSTax]
    ,cis.[DLBSTotal]
    ,cis.[PLBSBatchId]
    ,cis.[PLBSInvoiceDate]
    ,cis.[PLBSInvoiceNo]
    ,cis.[PLBSPrice]
    ,cis.[PLBSTax]
    ,cis.[PLBSTotal]
    ,cis.[BareProfileId]
    ,cis.[ServicePrice]
    ,cis.[ServicePriceComm]
    ,cis.[ServicePriceCommPercent]
    ,cis.[ServicePriceDiscountFixed]
    ,cis.[ServicePriceDiscountPercent]
    ,cis.[UpdatedOn]
  FROM  [FWFastlabel].[dbo].[fl_ConItemSrv] cis with (NOLOCK) 
  INNER JOIN [FWFastlabel].[dbo].[fl_Con] con with (NOLOCK) on con.ConId = cis.ConId
  INNER JOIN [FWFastlabel].[dbo].[fl_ConItem] ci with (NOLOCK) on ci.ConId = cis.ConId AND ci.ConItemId = cis.[ConItemId]
WHERE con.ConId &gt;= @ConId</property>
