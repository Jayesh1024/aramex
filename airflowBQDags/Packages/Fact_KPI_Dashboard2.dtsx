                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--DECLARE   @lastDateTime datetime = ?

--select @lastDateTime = '2020-03-01', @endDateTime  = '2020-07-20'

DECLARE @StartDateOnly datetime = DATEADD(DAY,-4, SYSDATETIME());
DECLARE @endDateOnly datetime = DATEADD(MINUTE,-5, SYSDATETIME());

--SET @StartDate = CONVERT(varchar(10),EOMONTH(DATEADD(MONTH, -1, @startDate )),120)+'T23:59:59.999';


SELECT 
    a.ID,
    a.RecordId,
    a.CountryCode,
    a.FranchiseeCode,
    a.ScanType,
    a.[Status] AS ScanStatus,
    a.LabelNo,
    a.ScanDate,
    a.CourierNo,
    a.UploadDate,
    a.RecordCreateDate,
    a.iLocate
    FROM FastwayReports.dbo.TrackAndTrace_7Day a (nolock)
    --FROM FastwayReports.dbo.TrackAndTraceData (nolock)
    WHERE Countrycode = 1  -- in (1,6,11,24) 
      AND Convert(date,RecordCreateDate) &gt;= @StartDateOnly AND Convert(date,RecordCreateDate) &lt;= @endDateOnly</property>
