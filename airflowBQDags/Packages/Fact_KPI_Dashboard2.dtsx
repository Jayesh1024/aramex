                      description="OLE DB Source"
                      name="Load fl_MF_Interim_Stg"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset">[dbo].[CFPolygon]</property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--DECLARE @startDate datetime = ?;

--DECLARE @startDate datetime2(3) = '2023-04-02T00:00:00';
--DECLARE @endDate datetime2(3) = '2023-02-17T08:00:00';

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;


DECLARE @startDate datetime2(3)

SET @StartDate = CONVERT(varchar(10),EOMONTH(DATEADD(MONTH, -2, Getdate() )),120)+'T23:59:59.999';

SELECT 
ci.[Label],
con.CountryId,
ci.FromRf,
ci.FromCf,
ci.ToRf,
ci.ToCf,
con.ToLocality,
con.ToPostalCode,
              con.RealisedDate,
              ci.[Zone],
  con.CreatedOn,
con.CustomerId
FROM [FWFastlabel].[dbo].[fl_Con] con
JOIN [FWFastlabel].[dbo].[fl_ConItemSum] cis on cis.ConId = con.ConId
JOIN [FWFastlabel].[dbo].[fl_ConItem] ci on ci.ConId = cis.ConId and ci.[LineNo] = cis.[LineNo]
WHERE con.CreatedOn &gt; @startDate
  AND Con.[RealisedDate] IS NOT NULL</property>
