              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\Staging\Staging 3\Load fl_ConItemSrv_Stg\fl_ConItemSrv (Fastway)"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="fl_ConItemSrv (Fastway)"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @startDate datetime = ?;
DECLARE @startDate2 datetime;

SET @StartDate2 = CONVERT(varchar(10),DATEADD(DAY, -1, Getdate()),120)+'T23:59:59.999';


SELECT ci.[Label]
      ,cis.[ConId]
      ,cis.[ConItemId]
      ,ci.[LineNo]
      ,ci.[CountryId]
      ,con.[CreatedOn]
      ,cis.[ProductId]
      ,cis.[ServiceItemId]
      ,cis.[FMSInvoiceNo]
      ,cis.[FMSInvoiceDate]
      ,cis.[Price]
      ,cis.[Tax]
      
,cis.[Total]
      ,cis.[PickUpPrice]
      ,cis.[DeliveryPrice]
    ,cis.[DLBSBatchId]
    ,cis.[DLBSInvoiceDate]
    ,cis.[DLBSInvoiceNo]
    ,cis.[DLBSPrice]
    ,cis.[DLBSTax]
    ,cis.[DLBSTotal]
    ,cis.[PLBSBatchId]
    ,cis.[PLBSInvoiceDate]
    ,cis.[PLBSInvoiceNo]
    ,cis.[PLBSPrice]
    ,cis.[PLBSTax]
    ,cis.[PLBSTotal]
    ,cis.[BareProfileId]
    ,cis.[ServicePrice]
    ,cis.[ServicePriceComm]
    ,cis.[ServicePriceCommPercent]
    ,cis.[ServicePriceDiscountFixed]
    ,cis.[ServicePriceDiscountPercent]
    ,cis.[UpdatedOn]
  FROM  [FWFastlabel].[dbo].[fl_ConItemSrv] cis
  INNER JOIN [FWFastlabel].[dbo].[fl_Con] con on con.ConId = cis.ConId
  INNER JOIN [FWFastlabel].[dbo].[fl_ConItem] ci on ci.ConId = cis.ConId AND ci.ConItemId = cis.[ConItemId]
WHERE con.[CreatedOn] &gt; @startDate2</property>
