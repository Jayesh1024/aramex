            ,[CreditedTax]
            ,[PurchaseOrderNumber]
            ,[Comments]
            ,[ExcludedFromBaseRate]
            ,Loaded = @LoadDate 
            ,ProcessID = -1
            ,RecordSource = 'INITIAL LOAD'
    FROM [Staging].[FMS_InvoiceHead_Stg_All]
    WHERE [SystemDate] &gt;= '2019-01-01'</property>
