      ,[NewPriceIncGST]
      ,[MultiplePriceOptions]
      ,[NewColour]
      ,[RCTIInvoiceNumber]
      ,[InvException]
      ,[InvExceptionReason]
      ,[ToLng]
      ,[ToLat]
      ,[ChildCharge]
FROM [dbo].[FMS_UndTcktInvoice]
WHERE [UnderTickId] &gt; @LastID AND  [UnderTickId] &lt;= @EndID</property>
