                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastID int = ?
DECLARE @BatchSize int = 100000;
DECLARE @EndID int;

SET  @EndID = @LastID + @Batchsize;

SELECT [UnderTickId]
      ,[CountryId]
      ,[LoggedByRF]
