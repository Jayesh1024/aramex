                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LoadDate Datetime2(7) = '2024-03-13';

SELECT 
             [Invoice_HSK] = dbo.GetHashKey( Convert(nvarchar,[InvoiceNumber]) +'^'+ [RFCode] ,'^'),
             [FranchiseeCode_HSK] = dbo.GetHashKey(RFCode,'^')
            ,[RFCode]
            ,[InvoiceNumber]
            ,[EnteredDate]
            ,[EnterTime]
            ,[CourierInvoiceBelongsTo]
