public class ScriptMain : UserComponent
{

    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    private static string getStringBetween(string strSource, string strStart, string strEnd)
    {
        int Start, End;
        if (strSource.Contains(strStart) && strSource.Contains(strEnd))
        {
            Start = strSource.IndexOf(strStart, 0) + strStart.Length;
            End = strSource.IndexOf(strEnd, Start);
            return strSource.Substring(Start, End - Start);
        }
        else
        {
            return strSource;
        }
    }

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        IDTSComponentMetaData130 componentMetaData = this.ComponentMetaData as IDTSComponentMetaData130;
        String columnName = "ServiceItemID"; //componentMetaData.GetIdentificationStringByID(Row.ErrorColumn);
        // columnName can be "tsections_Stg.Inputs[OLE DB Destination Input].Columns[RecordId]"
        // so call a function to get "RecordId"
        Row.ErrorColumnName = getStringBetween(columnName,"].Columns[","]");
       
        Row.ErrorDescription = this.ComponentMetaData.GetErrorDescription(Row.ErrorCode);
        Row.ErrorDateTime = DateTime.Now;

        Row.DatasetName = Variables.RecordSource13;
        Row.PackageName = Variables.PackageName;
        Row.ProcessID = Variables.ProcessId;

        Row.BusinessKey1 = Row.ServiceItemId.ToString();
        Row.BusinessKey2 = null;
        Row.SystemKey =  "ServiceItemID: " + Row.ServiceItemId.ToString();
    }

}
