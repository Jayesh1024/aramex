            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Staging\Load fl_ConSrv_Stg\fl_ConSrv (Fastway)"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="fl_ConSrv (Fastway)"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @startDate2 datetime  = DATEADD(DAY, -14, GETDATE());
DECLARE  @ConId bigint

SELECT TOP 1 @ConId = ConId
FROM [FWFastlabel].dbo.fl_Con (NOLOCK)
WHERE CreatedOn &gt;= @StartDate2
ORDER BY CreatedOn


SELECT cs.[ConId]
,con.[CountryId]
,con.[CreatedOn]
,cs.[ProductId]
,cs.[ServiceItemId]
,cs.[FMSInvoiceNo]
,cs.[FMSInvoiceDate]
,cs.[Price]
,cs.[Tax]
,cs.[Total]
,cs.[PickUpPrice]
,cs.[DeliveryPrice]
,cs.[DLBSBatchId]
,cs.[DLBSInvoiceDate]
,cs.[DLBSInvoiceNo]
,cs.[DLBSPrice]
,cs.[DLBSTax]
,cs.[DLBSTotal]
,cs.[PLBSBatchId]
,cs.[PLBSInvoiceDate]
,cs.[PLBSInvoiceNo]
,cs.[PLBSPrice]
,cs.[PLBSTax]
,cs.[PLBSTotal]
,cs.[ServicePrice]
,cs.[ServicePriceDiscountPercent]
,cs.[ServicePriceDiscountFixed]
,cs.[ServicePriceCommPercent]
,cs.[ServicePriceComm]
,cs.[UpdatedOn]
FROM [FWFastlabel].[dbo].[fl_ConSrv] cs WITH (NOLOCK)
INNER JOIN [FWFastlabel].[dbo].[fl_Con] con WITH (NOLOCK) on con.ConId = cs.ConId
WHERE con.ConId &gt;= @ConId</property>
                    <property
