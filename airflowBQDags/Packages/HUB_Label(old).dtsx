                    <component
                      refId="Package\Staging\Source1 (LabelMaster)\Load LabelMaster_Stg\LabelMaster data (FastwayReports)"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="LabelMaster data (FastwayReports)"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @startDate AS Datetime = ?; 

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

WITH Scan AS (
    SELECT LabelNo, max(UploadDate) as UploadDate
    FROM [FastwayReports].[dbo].[TrackAndTraceData] WITH (INDEX ([LabelNo,UploadDate,CountryCode_N]))
    WHERE UploadDate &gt; @startDate 
    AND CountryCode IN (1,6)
    GROUP BY LabelNo
)

SELECT 
       Label.[LabelNo]
      ,[CountryCode]
      ,[Electronic_CustomerType]
      ,[Electronic_CustomerID]
      ,[Electronic_Reference]
      ,[FastLabel_ConsignmentID]
      ,[FastLabel_DestinationRF]
      ,[Distribution_Date]
      ,[Distribution_FranchiseeCode]
      ,[KPI_PickupOK]
      ,[KPI_DeliveryOK]
      ,[KPI_LatePickup]
      ,[KPI_LateDelivery]
      ,[KPI_DelRF]
      ,[KPI_PicRF]
      ,[FMSCustomerID]
      ,[FMSRfID]
      ,[OES_CustomerId]
      ,[KPI_ExpectedDelivery]
      ,[KPI_ExceptionScan]
      ,[PrintedOn]
      ,[EbayClickCollect]
      ,[HasSubscriptions]
      ,Scan.[UploadDate]
FROM [FastwayReports].[dbo].[LabelMaster] AS Label
JOIN Scan ON Scan.LabelNo = Label.LabelNo ;</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::SourceDataQuery1</property>
