              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\Staging\Source6 (ConsignmentItem) _FLE\Load ConsignmentItem_Stg\ConsignmentItem (FastLabelServer)"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="ConsignmentItem (FastLabelServer)"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @startDate datetime = ?

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT 
       cl.LabelNumber,
       cl.CountryId,
       cm.WebCustomerId,
       c.CustomerId,
       c.ReceiverContactName,
       c.ReceiverCompanyName,
       c.ReceiverAddress1,
       c.ReceiverAddress2,
       c.ReceiverSuburb,
       c.ReceiverCity,
       c.ReceiverPostcode,
       c.SpecialInstructions,
       c.ReceiverPhone,
       c.ReceiverEmail,
       cl.PrintedOn, 
       ci.Reference,
       c.DestinationRF,
       c.ManifestId,
       c.Price,
       c.InvoiceNo,
       c.ItemCount,
       cl.CreatedOn,
       ci.WeightCubic,
       ci.WeightDead,
       ci.Width,
       ci.Length,
       ci.Height,
       cl.Colour,
       cl.ConsignmentItemId
FROM FastLabelServer.dbo.Consignment c 
JOIN FastLabelServer.dbo.ConsignmentItem ci on c.CountryId = ci.CountryId and c.CustomerId = ci.CustomerId and c.Id = ci.ConsignmentId
JOIN FastLabelServer.dbo.ConsignmentLabel cl on ci.CountryId = cl.CountryId and ci.CustomerId = cl.CustomerId and ci.Id = cl.ConsignmentItemId
LEFT JOIN FastLabelServer.dbo.CustomerMap cm on c.CountryId = cm.CountryId and c.CustomerId = cm.CustomerId 
WHERE cl.CreatedOn &gt; @startDate and cl.CountryId in (1,6)</property>
