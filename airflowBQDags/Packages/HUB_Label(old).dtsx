                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @LastID INT = ?;

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT
       [HistoryID]
      ,[SystemID]
      ,[LabelColour]
      ,[LabelNumber]
      ,[CountryCode]
      ,[Franchise]
      ,[PriceSoldAtExGST]
      ,[DateAllocatedUTC]
      ,[ExternalReference]
      ,[CustomerID]
      ,[FKID]
      ,[FKSource]
      ,[FMSInvoiceID]
      ,[FMSProductID]
      ,[AllocatedByCustomer]
      ,[CustomerUniqueID]
      ,[PickupTown]
      ,[PickupPostcode]
      ,[DeliveryTown]
      ,[DeliveryPostcode]
      ,[Weight]
      ,[DateAllocatedRelativeToRF]
      ,[DeletedLabel]
      ,[DeliveryAddr1]
      ,[DeliveryAddr2]
      ,[PickupAddr1]
      ,[PickupAddr2]
      ,[GroupTransId]
      ,[DeliveryPhoneNo]
      ,[LengthInCm]
      ,[WidthInCm]
      ,[HeightInCm]
      ,[CubicWeight]
FROM [OnlineEnquiries_NEW].[dbo].[API_RF_AdHocLabel_AllocationHistory]
WHERE [HistoryID] &gt; @LastID
    AND CountryCode IN (1,6)</property>
