                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @startDate datetime = ?

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT 
	d.LabelNumber, 
	d.CountryCode, 
	d.CreateDate, 
	d.LabelPrinted, 
	d.CustomerID, 
	d.ClientID, 
	d.ConsumedByCustomerUserID, 
	d.LblColour, 
	d.LblPrice, 
	d.LblPrice1,
	i.Reference, 
	i.Packaging, 
	i.Weight, 
	i.WeightCubic, 
	i.Length, 
	i.Width, 
	i.Height, 
	b.ManifestID, 
	b.Town, 
	b.PostCode, 
	b.destRF,
	i.itemID  
FROM [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Book_Detail] d
JOIN [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Consignment_Items] i on d.AppliedToItemID = i.ItemID
JOIN [OnlineEnquiries_NEW].[dbo].[tblFastLabel_Consignment] b on i.ConsignmentID = b.ConsignmentID
WHERE d.CreateDate &gt;@startDate
    AND d.CountryCode IN (1,6)</property>
