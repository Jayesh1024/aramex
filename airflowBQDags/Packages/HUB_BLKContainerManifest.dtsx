                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastScanDate varchar(50) = ?;
DECLARE @Min_ManifestID int = ?;
DECLARE @Batchsize int = ?;
--CONVERT(Datetime,'2023-05-01T00:00:00');

SELECT TOP (@Batchsize )
       MC.[ContainerManifestId]
      ,[LabelNo]
      ,[ScanDate]
      ,[ScanUserId]
      ,MC.[Destination]
      ,[MixedManifestId]
      ,[Weight]
      ,[CF]
  FROM [Fastway].[dbo].[BLK_ContainerManifestContents] MC 
WHERE [ScanDate] &gt; CONVERT(Date, @LastScanDate)
    AND MC.[ContainerManifestId] &gt; @Min_ManifestID -- Search rows elimination
ORDER BY  [ScanDate]</property>
