              SQLTask:SqlStatementSource="DECLARE @Source varchar(50) = ?;&#xA;DECLARE @LastScanDate datetime;&#xA;&#xA;SELECT @LastScanDate = MAX([ScanDate]) From [Staging].[BLK_ContainerManifestContents_Stg] WHERE [ScanDate] &lt; GETDATE()  -- prevent erroneous future dates&#xA;&#xA;UPDATE [Staging].[LoadControl] &#xA;SET LastValue = CONVERT(varchar(30), @LastScanDate)&#xA;WHERE [RecordSource] = @Source&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
