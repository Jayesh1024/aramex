                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastScanDate varchar(50) = ?;
--CONVERT(Datetime,'2023-05-01T00:00:00');

SELECT TOP 200000
       MC.[ContainerManifestId]
      ,[LabelNo]
      ,[ScanDate]
      ,[ScanUserId]
      ,MC.[Destination]
      ,[MixedManifestId]
      ,[Weight]
      ,[CF]
