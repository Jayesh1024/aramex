                  description="OLE DB Source"
                  name="FMS_Courier data (Fastway)"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[FMS_Courier]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    c.[RFCode],
    [CourierNumber],
    g.[Description] as CourierGroup,
    [Name],
    [ShortName],
    [CFName],
    [Address1],
    [Address2],
    [Address3],
    [Address4],
    [EmailAddress],
    [PhoneNumber],
    [Mobile],
    [BlackbayRouteId],
    w.[Description] AS CFOwnershipModel,
    c.[Inactive],
    ParcelConnectCFTerritory
FROM [Fastway].[dbo].[FMS_Courier] c
         left join [FMS_LookUpTableDetail] g ON c.RFCode = g.RFCode AND HeaderCode = 'GRP' AND c.CourierGroup = g.ItemCode
         left join [FMS_LookUpTableDetail] w ON w.HeaderCode = 'OWN' AND w.ItemCode = c.CFOwnershipModel AND c.NMid = w.NMid
WHERE Inactive = 0;</property>
