                  name="Load API_RF_AdHocLabel_AllocationHistory data (OnlineEnquiries_NEW)"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @LastID INT = ?;
--Get Previous Sunday or Today if day is SUN  - 19050101 was a SUN
DECLARE @maxDate  date = DATEADD(wk, DATEDIFF(wk, '19050101',  GETDATE()), '19050101')


SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT
       [HistoryID]
      ,[SystemID]
      ,[LabelColour]
      ,[LabelNumber]
      ,[CountryCode]
      ,[Franchise]
      ,[PriceSoldAtExGST]
      ,[DateAllocatedUTC]
      ,[ExternalReference]
      ,[CustomerID]
      ,[FKID]
      ,[FKSource]
      ,[FMSInvoiceID]
      ,[FMSProductID]
      ,[AllocatedByCustomer]
      ,[CustomerUniqueID]
      ,[PickupTown]
      ,[PickupPostcode]
      ,[DeliveryTown]
      ,[DeliveryPostcode]
      ,[Weight]
      ,[DateAllocatedRelativeToRF]
      ,[DeletedLabel]
      ,[DeliveryAddr1]
      ,[DeliveryAddr2]
      ,[PickupAddr1]
      ,[PickupAddr2]
      ,[GroupTransId]
      ,[DeliveryPhoneNo]
      ,[LengthInCm]
      ,[WidthInCm]
      ,[HeightInCm]
      ,[CubicWeight]
FROM [OnlineEnquiries_NEW].[dbo].[API_RF_AdHocLabel_AllocationHistory] WITH (NOLOCK)
  WHERE [HistoryID] &gt; @LastID - 6000000
 AND [DateAllocatedUTC] &lt;  @maxDate</property>
