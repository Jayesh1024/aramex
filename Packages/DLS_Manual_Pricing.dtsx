        <DTS:Executable
          DTS:refId="Package\Source2 (DynamicLabel) _DL\Update Dim_Label"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Update Dim_Label"
          DTS:DTSID="{CBDC8336-6B2A-42F5-88C6-CF218AC2DB16}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Update Dim_Label"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{66292261-9521-45A6-ACCA-54377A482A00}"
              SQLTask:SqlStatementSource="DECLARE @ProcessID Int = ?;&#xA;DECLARE @UpdateDate datetime2(7) = GetDate();&#xA;&#xA;&#xA;UPDATE D&#xA;SET D.[FMSInvoiceID] = A.[FMSInvoiceID],&#xA;&#x9;&#x9;D.[Price] = A.[Price],&#xA;&#x9;&#x9;ProcessId = @ProcessID,&#xA;&#x9;&#x9;Updated = @UpdateDate&#xA;&#xA;FROM [FastwayDW].[dbo].[Dim_Label] D&#xA;INNER JOIN [FastwayDW].[dv].[SAT_Label_Allocation_DL] A ON A.LabelNo = D.LabelNo AND IsCurrent = 1&#xA;WHERE A.[ProcessId] = @ProcessID&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::ProcessId"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
