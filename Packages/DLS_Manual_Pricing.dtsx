          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{66292261-9521-45A6-ACCA-54377A482A00}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource="USE FastwayDW&#xA;GO&#xA;&#xA;&#xA;TRUNCATE TABLE [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg] &#xA;GO&#xA;&#xA;INSERT INTO [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg] &#xA;(&#xA;&#x9;  [HistoryID]&#xA;      ,[SystemID]&#xA;      ,[LabelColour]&#xA;      ,[LabelNumber]&#xA;      ,[CountryCode]&#xA;      ,[Franchise]&#xA;      ,[PriceSoldAtExGST]&#xA;      ,[DateAllocatedUTC]&#xA;      ,[ExternalReference]&#xA;      ,[CustomerID]&#xA;      ,[FKID]&#xA;      ,[FKSource]&#xA;      ,[FMSInvoiceID]&#xA;      ,[FMSProductID]&#xA;      ,[AllocatedByCustomer]&#xA;      ,[CustomerUniqueID]&#xA;      ,[PickupTown]&#xA;      ,[PickupPostcode]&#xA;      ,[DeliveryTown]&#xA;      ,[DeliveryPostcode]&#xA;      ,[Weight]&#xA;      ,[DateAllocatedRelativeToRF]&#xA;      ,[DeletedLabel]&#xA;      ,[DeliveryAddr1]&#xA;      ,[DeliveryAddr2]&#xA;      ,[PickupAddr1]&#xA;      ,[PickupAddr2]&#xA;      ,[GroupTransId]&#xA;      ,[DeliveryPhoneNo]&#xA;      ,[LengthInCm]&#xA;      ,[WidthInCm]&#xA;      ,[HeightInCm]&#xA;      ,[CubicWeight]&#xA;)&#xA;SELECT [HistoryID]&#xA;      ,[SystemID]&#xA;      ,H.[LabelColour]&#xA;      ,[LabelNumber]&#xA;      ,H.[CountryCode]&#xA;      ,[Franchise]&#xA;      ,[PriceSoldAtExGST]&#xA;      ,[DateAllocatedUTC]&#xA;      ,[ExternalReference]&#xA;      ,[CustomerID]&#xA;      ,H.[FKID]&#xA;      ,H.[FKSource]&#xA;      ,H.[FMSInvoiceID]&#xA;      ,H.[FMSProductID]&#xA;      ,[AllocatedByCustomer]&#xA;      ,[CustomerUniqueID]&#xA;      ,[PickupTown]&#xA;      ,[PickupPostcode]&#xA;      ,[DeliveryTown]&#xA;      ,[DeliveryPostcode]&#xA;      ,[Weight]&#xA;      ,[DateAllocatedRelativeToRF]&#xA;      ,[DeletedLabel]&#xA;      ,[DeliveryAddr1]&#xA;      ,[DeliveryAddr2]&#xA;      ,[PickupAddr1]&#xA;      ,[PickupAddr2]&#xA;      ,H.[GroupTransId]&#xA;      ,[DeliveryPhoneNo]&#xA;      ,[LengthInCm]&#xA;      ,[WidthInCm]&#xA;      ,[HeightInCm]&#xA;      ,[CubicWeight]&#xA;FROM  [Staging].[API_RF_AdHocLabel_AllocationHistory_Stg_Weekly] H&#xA;INNER JOIN  [FastwayDW].[dv].[SAT_Label_Allocation_DL] DL ON H.HistoryID = DL.[RecordSourceId] AND DL.IsCurrent = 1&#xA;WHERE (&#xA;&#xA;&#x9;(DL.Price != H.[PriceSoldAtExGST] )  OR &#xA;&#x9;( ISNULL(DL.FMSInvoiceID,0) != ISNULL(H.FMSInvoiceID,0) )  &#xA;)&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
