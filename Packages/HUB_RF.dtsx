                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    [FranchiseeCode], f.[CountryCode], c.[Country], f.[RFId], 
    f.[Name], f.[Email], f.[LegalTradingEntity], f.[ABN], f.[ACN], f.[TaxNumber],
    f.[Add1], f.[Add2], f.[Add3], f.[Add4], f.[Phone], f.[Fax],
    f.[FranchiseEnquiryEmail], f.[State], f.[Suburb], f.[PostCode], 
    f.[Phone2], f.[AccountsEmail], f.[FMSType],
    [CompanyOwnedRF],
    [UsingWebFMSBanking]
FROM [Fastway].[dbo].[Franchisee] f 
LEFT JOIN [Fastway].[dbo].[Country] c ON c.[Code] = f.[CountryCode];</property>
