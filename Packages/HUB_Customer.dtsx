            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Staging\Load CustomerLinks_Stg\CustomerLinks data (Fastway)"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="CustomerLinks data (Fastway)"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">USE Fastway;
                      SELECT 
                          Concat(RFId, RIGHT('000'+CourierNumber,3), RIGHT('0000'+CAST(CustomerNumber AS VARCHAR(4)),4)) as CustomerKey, 
                          ltrim(rtrim(fms.BusinessName)) as CustomerName,
                          fms.NMId as CountryCode, 
                          fms.RFId as RFCode,
                          fms.CustomerId as FMSCustomerID, 
                          lnk.OESCustomerID, 
                          lnk.IFSCustomerCode,
                          lnk.IFSCustomerType  
                      FROM FMS_Customer fms
                      LEFT JOIN (
                          Select  
                              coalesce(oes.CountryCode,ifs.CountryCode) as CountryCode, 
                              coalesce(oes.CustomerID, ifs.FMSCustomerId) as FMSCustomerID, 
                              OESCustomerID, 
                              IFSCustomerCode,
                              CustomerType as IFSCustomerType
                          From DLS_CustomerLinks oes
                          Full Join IFSCustomers ifs on oes.CustomerID = ifs.FMSCustomerId and oes.CountryCode = ifs.CountryCode and ifs.RFCode = oes.Franchise
                      ) lnk ON fms.CustomerId = lnk.FMSCustomerID and fms.NMId = lnk.CountryCode
                      WHERE fms.NMId in (1,6,11,24)
                      ORDER BY 1;</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
