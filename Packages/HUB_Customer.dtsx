      ,[SellProductsViaInternet]
      ,[PercentageOfDeliveriesAreHome]
      ,[IndustryClassification]
      ,g.Description as IndustryDescription
      ,[IndustryClassifcationOtherDes]
      ,[CompanyNumber]
      ,[StartDate]
      ,[UnsubscribeFromEmail]
