                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [RFId]
      ,[CourierNumber]
      ,[CustomerID] 
      ,[CustomerKey] = Concat(RFId, RIGHT('000'+CAST(CourierNumber AS VARCHAR(3)),3), RIGHT('0000'+CAST(CustomerNumber AS VARCHAR(4)),4))
      ,[CustomerNumber]
