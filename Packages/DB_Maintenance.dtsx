                <SQLTask:SqlTaskData
                  SQLTask:Connection="{66292261-9521-45A6-ACCA-54377A482A00}"
                  SQLTask:SqlStatementSource="EXEC [dbo].[MaintainIndexes] @Operation = 'DEFRAG', @SchemaName = 'dbo';&#xA;&#xA;EXEC [dbo].[MaintainIndexes] @Operation = 'STATS', @SchemaName = 'dbo';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
