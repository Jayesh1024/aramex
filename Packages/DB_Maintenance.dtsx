        <DTS:Executable
          DTS:refId="Package\Database Maintenance\Release Space"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{98DD297F-4F01-4F80-BED8-F97F1DA246C5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Release Space"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{66292261-9521-45A6-ACCA-54377A482A00}"
              SQLTask:SqlStatementSource="/*&#xA;    Release unused space at the end of data files to the OS&#xA;*/&#xA;DECLARE @SQL NVARCHAR(250) = '&#xA;BEGIN TRY &#xA;  DBCC SHRINKFILE (@1, TRUNCATEONLY);&#xA;  WAITFOR DELAY ''00:00:10'';&#xA;END TRY&#xA;BEGIN CATCH&#xA;END CATCH&#xA;';&#xA;DECLARE @Script NVARCHAR(max) = 'USE [FastwayDW];'&#xA;&#xA;SELECT @Script = @Script + REPLACE(@SQL,'@1',FileId)&#xA;FROM (&#xA;  SELECT df.file_id as FileId, df.name as [FileName], df.type_desc as FileType, df.physical_name, fg.name as [FileGroup]&#xA;  FROM sys.database_files df&#xA;  JOIN sys.filegroups fg ON fg.data_space_id = df.data_space_id&#xA;  WHERE df.type_desc = 'ROWS'&#xA;    AND df.state_desc = 'ONLINE'&#xA;    AND fg.name NOT IN ('PRIMARY','KPI')&#xA;) f&#xA;ORDER BY [FileType] DESC, [FileGroup] DESC&#xA;&#xA;--PRINT (@Script);&#xA;EXEC (@Script);&#xA;&#xA;/*&#xA;    Release unused LOG space to the OS&#xA;*/&#xA;EXEC ('DBCC SHRINKFILE (2, TRUNCATEONLY)');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Database Maintenance.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{FF2FC647-947E-4818-BD92-6CCAFD125A5B}"
          DTS:From="Package\Database Maintenance\Index Maintentance"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Database Maintenance\Release Space"
          DTS:Value="2" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
  </DTS:Executables>
